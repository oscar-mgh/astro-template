---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lorem ipsum">
	<main class="page-wrap flex min-h-[calc(100svh-5rem)] items-center py-12 sm:py-16">
		<div class="flex w-full flex-col items-center justify-between gap-12 lg:flex-row lg:gap-16">
			<div class="w-full max-w-xl">
				<p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-primary">
					Lorem ipsum dolor sit amet
				</p>
				<h1 class="font-display text-5xl font-bold leading-[1.05] text-stone-950 sm:text-6xl dark:text-stone-50">
					Lorem ipsum <span class="text-primary">dolor</span> sit amet.
				</h1>
				<p class="mt-6 max-w-lg text-base leading-7 text-stone-600 sm:text-lg sm:leading-8 sm:font-display dark:text-stone-300">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
				</p>
			</div>

			<div
				role="img"
				aria-label="Lorem ipsum, imagen de muestra"
				class="hero-placeholder relative aspect-[4/3] w-full max-w-xl overflow-hidden rounded-md bg-primary-soft"
			>
				<div class="absolute left-[12%] top-[13%] h-[74%] w-[54%] border border-white/70 bg-white/25"></div>
				<div class="absolute bottom-[13%] right-[10%] flex h-[44%] w-[46%] items-end bg-[#e6a875] p-5 text-sm font-medium text-stone-950 sm:text-base">
					Lorem ipsum
				</div>
				<span class="absolute right-[12%] top-[12%] font-display text-5xl text-stone-900/70 dark:text-stone-100/80">01</span>
			</div>
		</div>
	</main>
</Layout>
