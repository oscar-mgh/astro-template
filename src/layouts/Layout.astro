---
import Navbar from '../components/Navbar.astro';
import { WHATSAPP_NUMBER } from 'astro:env/server';
import '../styles/global.css';

const {
	title = 'Mansir | Mantenimiento integral en Toluca',
	description = 'Servicios de mantenimiento integral, instalaciones eléctricas, plomería y remodelación para hogares y negocios en Toluca, Nuevo León.',
	keywords = '',
} = Astro.props;
const siteKeywords = 'Mansir, mantenimiento integral, mantenimiento en Toluca, mantenimiento residencial, mantenimiento comercial, mantenimiento de hogares, mantenimiento de negocios, mantenimiento de inmuebles, mantenimiento preventivo, mantenimiento correctivo, mantenimiento de edificios, servicios de mantenimiento, construcción en Toluca, servicios de construcción, remodelación en Toluca, remodelación de casas, remodelación de negocios, proyectos de remodelación, reparación de viviendas, reparaciones para negocios, instalaciones eléctricas, electricidad residencial, electricidad comercial, electricista en Toluca, reparación eléctrica, mantenimiento eléctrico, instalaciones de plomería, plomería en Toluca, plomero en Toluca, reparación de tuberías, instalaciones hidráulicas, soluciones integrales para inmuebles, servicios para el hogar, mantenimiento para empresas, mantenimiento de espacios comerciales, contratista de mantenimiento en Toluca, servicios para casas y negocios en Nuevo León';
const seoKeywords = [siteKeywords, keywords].filter(Boolean).join(', ');
const whatsappPhoneNumber = WHATSAPP_NUMBER.replace(/\D/g, '');

if (!/^\d{8,15}$/.test(whatsappPhoneNumber)) {
	throw new Error('WHATSAPP_NUMBER debe incluir entre 8 y 15 dígitos, con código de país y sin el signo +.');
}

const whatsappMessage = encodeURIComponent('Hola, me gustaría solicitar información sobre sus servicios');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="keywords" content={seoKeywords} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<script is:inline>
			try {
				if (localStorage.getItem('theme') === 'dark') {
					document.documentElement.classList.add('dark');
				}
			} catch {}
		</script>
	</head>
	<body class="min-h-screen px-7 sm:px-8 lg:px-0">
		<Navbar />
		<div class="page-enter">
			<slot />
		</div>
		<a
			href={`https://wa.me/${whatsappPhoneNumber}?text=${whatsappMessage}`}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Contáctanos por WhatsApp"
			class="group fixed bottom-5 right-5 z-50 flex size-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#128C7E]"
		>
			<svg
        class="h-8 w-8 fill-current"
        viewBox="0 0 24 24">
        <path
          d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
      </svg>
			<span role="tooltip" class="pointer-events-none absolute right-full mr-3 whitespace-nowrap rounded-md bg-stone-950 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
				Contáctanos por WhatsApp
			</span>
		</a>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
